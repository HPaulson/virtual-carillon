{
  "name": "virtual-carillon",
  "version": "0.1.0-beta.1",
  "description": "A virtual carillon with Catholic bells, hymn arrangements, and Home Assistant integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HPaulson/virtual-carillon.git"
  },
  "bugs": {
    "url": "https://github.com/HPaulson/virtual-carillon/issues"
  },
  "homepage": "https://github.com/HPaulson/virtual-carillon#readme",
  "keywords": [
    "audio",
    "carillon",
    "home-assistant",
    "liturgical",
    "nodejs"
  ],
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "bin": {
    "virtual-carillon": "bin/virtual-carillon.mjs"
  },
  "files": [
    "dist",
    "bin",
    "custom_components",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli/index.ts server",
    "start": "node dist/cli/index.js server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "ci:check": "node scripts/check-ci.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
