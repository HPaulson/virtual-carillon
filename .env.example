# Copy this file to .env, or enter these values in Dokploy's Environment tab.
# Dokploy writes that tab to the .env file consumed by compose.yaml.

VIRTUAL_CARILLON_HOST=0.0.0.0
VIRTUAL_CARILLON_PORT=9876
VIRTUAL_CARILLON_DATA_DIR=/app/.data
# Set a long random value before exposing the API through a domain.
VIRTUAL_CARILLON_API_TOKEN=
VIRTUAL_CARILLON_SAMPLE_RATE=44100
