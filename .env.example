# Docker/production defaults. Copy to .env and set a strong token before
# exposing the API outside a trusted local network.
VIRTUAL_CARILLON_HOST=0.0.0.0
VIRTUAL_CARILLON_PORT=9876
VIRTUAL_CARILLON_DATA_DIR=/app/.data
VIRTUAL_CARILLON_API_TOKEN=
VIRTUAL_CARILLON_DISTANCE_PROFILE=half-mile
VIRTUAL_CARILLON_SAMPLE_RATE=44100

# Optional LitCal integration. Home Assistant owns the corresponding
# calendar and schedule settings in the normal deployment.
VIRTUAL_CARILLON_LITCAL_ENABLED=false
VIRTUAL_CARILLON_LITCAL_URL=https://litcal.johnromanodorazio.com/api/v5
VIRTUAL_CARILLON_LITCAL_CALENDAR=general
