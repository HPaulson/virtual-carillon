# The base Docker deployment is portable and needs no host audio variables.
# For Linux PipeWire/Bluetooth audio, copy this file to .env and set:
# HOST_XDG_RUNTIME_DIR=/run/user/1000
VIRTUAL_CARILLON_LITCAL_ENABLED=false
VIRTUAL_CARILLON_LITCAL_URL=https://litcal.johnromanodorazio.com/api/v5
VIRTUAL_CARILLON_LITCAL_CALENDAR=general
# Listener model; half-mile is the default outdoor far-field profile.
VIRTUAL_CARILLON_DISTANCE_PROFILE=half-mile
